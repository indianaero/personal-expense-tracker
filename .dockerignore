# Git
.git
.gitignore

# Dependencies — reinstalled inside the image by npm ci
node_modules

# Next.js build output — rebuilt inside the image
.next
out

# Environment files — secrets must never enter the image
.env
.env.*
!.env.example

# Vercel CLI artifacts
.vercel

# Editor and OS
.DS_Store
*.pem
.vscode
.idea
*.swp
*.swo

# Test artefacts
coverage
__tests__

# Documentation
docs
*.md
!README.md

# Scripts not needed at runtime
scripts

# Supabase local dev
supabase/.branches
supabase/.temp

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info — regenerated during build
*.tsbuildinfo
